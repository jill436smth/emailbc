# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# PayPal (sandbox credentials from developer.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENV=sandbox

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Receipt branding
BRAND_NAME=QuickPay Portal
SUPPORT_EMAIL=support@quickpayportal.com
PAY_BILL_URL=https://google.com

# Resend (https://resend.com) — receipt emails; domain must be verified
RESEND_API_KEY=
MAIL_FROM=bills@perr-yourhealth.com
